#cloud-config
hostname: ${hostname}
fqdn: ${hostname}
timezone: ${timezone}

# パスワードログインは無効。鍵認証のみ
ssh_pwauth: false

users:
  - name: ${admin_user}
    groups: [wheel]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

packages:
  - qemu-guest-agent

runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]

final_message: "cloud-init finished after $UPTIME seconds"
