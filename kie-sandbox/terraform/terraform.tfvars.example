# cp terraform.tfvars.example terraform.tfvars して編集する (terraform.tfvars は git 管理外)

# ~/.ssh/config の Host エイリアスを使う場合の例
libvirt_uri = "qemu+sshcmd://kvm-host/system"

vm_name    = "kie-sandbox"
vcpu       = 2
memory_mib = 6144
disk_gib   = 30

# Rocky 10 を使う場合
# rocky_image_url = "https://dl.rockylinux.org/pub/rocky/10/images/x86_64/Rocky-10-GenericCloud-Base.latest.x86_64.qcow2"

bridge_name = "br0"
vm_ip_cidr  = "192.168.1.51/24"
gateway     = "192.168.1.1"
dns_servers = ["192.168.1.1"]

admin_user          = "rocky"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
